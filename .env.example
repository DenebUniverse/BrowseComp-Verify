# Copy to .env, edit values, then: set -a; source .env; set +a
# For remote inference, use your own API key. Never commit .env.
OPENAI_API_KEY=EMPTY
MODEL_NAME=gpt-oss-120b
MODEL_URL=http://127.0.0.1:8001/v1
SEARCH_URL=http://127.0.0.1:8000
# Qwen3.5 and the DeepSeek search/visit ablation use a separate summary model.
SUMMARY_URL=http://127.0.0.1:8002/v1/chat/completions
# Set provider credentials in this private file when needed:
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

SEARCHER_TYPE=dense
CORPUS_PARQUET_PATH="external/browsecomp-plus-corpus/data/*.parquet"
DENSE_INDEX_PATH="external/indexes/qwen3-embedding-8b/*.pkl"
DENSE_MODEL_NAME=Qwen/Qwen3-Embedding-8B
GPU_IDS=0
LUCENE_INDEX_DIR=external/indexes/bm25
# Use jars matching your Anserini/Lucene version, if additional jars are needed.
LUCENE_EXTRA_DIR=external/lucene
SNIPPET_MODE=lucene
MAX_SNIPPET_LEN=180
SEARCH_HOST=127.0.0.1
SEARCH_PORT=8000

# Keep each local numerical-library process to one CPU thread.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

